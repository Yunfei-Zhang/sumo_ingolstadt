<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
  
  <!-- As 2023-07-03_rq3_cosim.sumocfg, plus 2023-07-03_rq3_event_inc.add.xml. --><input>
    <net-file value="ingolstadt_net.net.xml" />
    <route-files value="Routes/routes_2023-07-03_24h_det_calib_minus_rq3_0703.rou.xml.gz" />
    <additional-files value="PT/pt_stops.add.xml, PT/2023-07-03_gtfs_trips.rou.xml, rq3_amod_vtype.add.xml, 2023-07-03_rq3_event_inc.add.xml" />
  </input>
  <time>
    <begin value="00:00:00" />
    <end value="24:00:00" />
  </time>
  <processing>
    <step-length value="1" />
    <scale value="0.85" />
    <ignore-junction-blocker value="15" />
    <time-to-teleport value="60" />
    <max-depart-delay value="100" />
    <device.rerouting.probability value="0.5" />
  </processing>
</configuration>