<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
  <!-- Event 1 (demand surge): 2023-07-09 base demand + football-match surge near
       Audi Sportpark (KO 15:30). Surge trips appended to route-files; SUMO routes
       each trip at insertion. docs/5_rq3_event_scenarios.md sec 3. -->
  <input>
    <net-file value="ingolstadt_net.net.xml" />
    <route-files value="Routes/routes_2023-07-09_24h_det_calib.rou.xml.gz, 2023-07-09_event_surge.trips.xml" />
    <additional-files value="TL/2023-07-09_tlLogics_24h.tll.xml, TL/2023-07-09_WAUT.xml, PT/pt_stops.add.xml, PT/2023-07-09_gtfs_trips.rou.xml" />
  </input>
  <time>
    <begin value="00:00:00" />
    <end value="24:00:00" />
  </time>
  <processing>
    <step-length value="1" />
    <ignore-junction-blocker value="15" />
    <time-to-teleport value="240" />
    <max-depart-delay value="100" />
    <device.rerouting.probability value="0.7" />
  </processing>
</configuration>
